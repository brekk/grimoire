// Bootstrap.mad — one-time fixed-point registrar over the ecosystem table.
// Reads  ./table.md   (the gist table, verbatim)
// Writes ./registry/index.json and ./registry/packages/<name>.json

import type { ClientError, Error } from "Http"

import type { MadlibDotJson } from "mad-at-json/Parse/MadlibJson"

import Dictionary from "Dictionary"
import File from "File"
import Fn from "Function"
import Http from "Http"
import IO from "IO"
import List from "List"
import Maybe from "Maybe"
import { Just, Nothing } from "Maybe"
import String from "String"
import Tuple from "Tuple"
import Wish from "Wish"

// mad-at-json v0.2.0 public surface (src/Library.mad):
//   MadAtJson.MadlibDotJson { bin, dependencies :: Maybe (List MadAtJson.Dependency),
//     main, name, version :: Version.Version }
//   MadAtJson.parse, MadAtJson.load :: ... -> Wish String MadlibDotJson
//   MadAtJson.Dependency { description, name, sanitizedUrl, url,
//     versionRange :: Version.VersionRange } — already parsed, no adapter needed.
import MadAtJson from "mad-at-json"
import Version from "mad-at-json/Version"



massageHTTPErrorIntoString :: Error String -> String
massageHTTPErrorIntoString = where {
  Http.BadResponse({ body, status }) =>
    `{status}:${body}`

  Http.ClientError(Http.BadUrl(url)) =>
    url

  Http.ClientError(r) =>
    show(r)
}
alias TableRow = {
  deprecatedBy :: Maybe String,
  description :: String,
  executable :: Boolean,
  isBinding :: Boolean,
  name :: String,
  owner :: String,
  publishedAt :: String,
  repository :: String,
  tag :: Maybe String,
  version :: String,
}
alias Manifest = {
  bin :: Maybe String,
  dependencies :: List MadAtJson.Dependency,
  main :: String,
  name :: String,
  version :: Version.Version,
}
type PinType = TagPin | BranchPin | LocalPin | UnresolvedPin
alias ResolvedDep = {
  pinType :: PinType,
  rawUrl :: String,
  targetName :: String,
  versionRange :: Version.VersionRange,
}
alias Package = {
  dependencies :: List ResolvedDep,
  deprecatedBy :: Maybe String,
  description :: String,
  executable :: Boolean,
  isBinding :: Boolean,
  latestTag :: String,
  latestUrl :: String,
  latestVersion :: Version.Version,
  name :: String,
  owner :: String,
  publishedAt :: String,
  repository :: String,
}
type BlockReason
  = NoRelease
  | ManifestFetchFailed
  | BranchPinnedDep(String)
  | LocalDep(String)
  | DepNotRegistered(String)
// ---------------------------------------------------------------------------
// Table parsing (the gist, as markdown)
// ---------------------------------------------------------------------------

linkTarget :: String -> Maybe String
linkTarget = (cell) => where(String.split("]", cell)) {
  [_, rest, ..._] =>
    where(String.split(")", rest)) {
      [url, ..._] =>
        Just(url)

      _ =>
        Nothing
    }

  _ =>
    Nothing
}
isWhitespace :: String -> Boolean
isWhitespace = pipe(
  String.trim,
  String.isEmpty,
)
unquote :: String -> String
unquote = pipe(
  String.dropLast(1),
  String.drop(1),
  String.trim,
)
parseRow :: String -> Maybe TableRow
parseRow = pipe(
  String.split("|"),
  where {
    [_, nameCell, owner, description, versionCell, date, _deps, exeCell, bindCell, depNote, ..._] =>
      do {
        url = linkTarget(nameCell)
        return where(url) {
          Just(u) =>
            where(String.split("/", u)) {
              [_, _, _, owner2, repo] =>
                do {
                  releaseUrl = linkTarget(versionCell)
                  return Just({
                    name: repo,
                    owner: owner2,
                    repository: u,
                    description: String.trim(description),
                    version: unquote(versionCell),
                    tag: map(
                      pipe(
                        unquote,
                        mappend("v"),
                      ),
                    )(releaseUrl),
                    publishedAt: String.trim(date),
                    executable: isWhitespace(exeCell),
                    isBinding: isWhitespace(bindCell),
                    deprecatedBy: where(String.trim(depNote)) {
                      t =>
                        t == "" ? Nothing : linkTarget(depNote)
                    },
                  })
                }

              _ =>
                Nothing
            }

          Nothing =>
            Nothing
        }
      }

    _ =>
      Nothing
  },
)
box = (x) => [
  // parseTable :: String -> List (Maybe TableRow)
  x,
]
parseTable :: String -> List TableRow
parseTable = pipe(
  String.split("\n"),
  List.filter(
    pipe(
      String.trim,
      String.take(2),
      Fn.equals("| "),
    ),
  ),
  map(parseRow),
  List.filter(Maybe.isJust),
  List.reduce(
    (acc, x) => where(x) {
      Just(y) =>
        List.append(y, acc)

      _ =>
        acc
    },
    [],
  ),
)
// ---------------------------------------------------------------------------
// Manifest fetching (raw.githubusercontent at the release tag)
// ---------------------------------------------------------------------------

manifestUrl :: TableRow -> String
manifestUrl = (row) => where(row.tag) {
  Just(tag) =>
    `https://raw.githubusercontent.com/${row.owner}/${row.name}/${tag}/madlib.json`

  Nothing =>
    ""
}
// I didn't know this was a valid type construct, that's useful
adaptManifest :: MadAtJson.MadlibDotJson -> Manifest
adaptManifest = (x) => {
  { bin, dependencies, name, version } = x
  // return { bin, dependencies: Maybe.fromMaybe([], dependencies), main: x.main, name, version }
  return { bin, dependencies: Maybe.fromMaybe([], dependencies), main: x.main, name, version }
}
// parse failures fold to Nothing; MadAtJson.parse is plain Wish String, not
// Validate-wrapped, in v0.2.0 — nothing to distinguish (yet) between a soft
// warning and a hard error at this seam.
decodeManifest :: String -> Wish x (Maybe Manifest)
decodeManifest = pipe(
  MadAtJson.parse,
  map(
    pipe(
      adaptManifest,
      Just,
    ),
  ),
  Wish.chainRej((_) => Wish.good(Nothing)),
)
fetchManifest :: TableRow -> Wish (Http.Error String) #[TableRow, Maybe Manifest]
fetchManifest = (row) => where(row.tag) {
  Nothing =>
    Wish.good(#[row, Nothing])

  Just(_) =>
    chain(
      ({ status, body }) => status == Http.OK
        ? map((manifest) => #[row, manifest])(decodeManifest(body))
        : Wish.good(#[row, Nothing]),
    )(
      pipe(
        manifestUrl,
        Http.get,
      )(row),
    )
}
fetchAllManifests :: List TableRow -> Wish String (List #[TableRow, Maybe Manifest])
fetchAllManifests = pipe(
  map(fetchManifest),
  Wish.parallel,
  Wish.mapRej(massageHTTPErrorIntoString),
)
alias ClassifiedPath = { branchPath :: String, localPath :: String, tagPath :: String }
classifyPinWithConfig :: ClassifiedPath -> String -> PinType
classifyPinWithConfig = ({ tagPath, branchPath, localPath }, url) => String.contains(tagPath, url)
  ? TagPin
  : String.contains(branchPath, url)
    ? BranchPin
    : String.startsWith(localPath, url) ? LocalPin : UnresolvedPin
classifyPin :: String -> PinType
classifyPin = classifyPinWithConfig({
  tagPath: "/archive/refs/tags/",
  branchPath: "/archive/refs/heads/",
  localPath: "file://",
})
repoNameFromUrl :: String -> Maybe String
repoNameFromUrl = pipe(
  String.split("/"),
  where {
    [_, _, _, _owner, repo, ..._] =>
      Just(repo)

    _ =>
      Nothing
  },
)
resolveDep :: MadAtJson.Dependency -> ResolvedDep
resolveDep = ({ url, versionRange }) => (
  {
    targetName: Maybe.fromMaybe("", repoNameFromUrl(url)),
    rawUrl: url,
    versionRange,
    pinType: repoNameFromUrl(url) == Nothing ? UnresolvedPin : classifyPin(url),
  }
)
resolveDeps :: List MadAtJson.Dependency -> List ResolvedDep
resolveDeps = map(resolveDep)
// ---------------------------------------------------------------------------
// The fixed point
// ---------------------------------------------------------------------------

depSatisfied :: Dictionary String Package -> ResolvedDep -> Maybe BlockReason
depSatisfied = (registered, { pinType, targetName, versionRange }) => where(pinType) {
  BranchPin =>
    Just(BranchPinnedDep(targetName))

  LocalPin =>
    Just(LocalDep(targetName))

  UnresolvedPin =>
    Just(DepNotRegistered(targetName))

  TagPin =>
    where(Dictionary.get(targetName, registered)) {
      Nothing =>
        Just(DepNotRegistered(targetName))

      Just(target) =>
        Version.withinRange(versionRange, target.latestVersion)
          ? Nothing
          : Just(DepNotRegistered(targetName))
    }
}
rowBlockReason :: Dictionary String Package -> #[TableRow, Maybe Manifest] -> Maybe BlockReason
rowBlockReason = (registered, #[row, manifest]) => where(#[row.tag, manifest]) {
  #[Nothing, _] =>
    Just(NoRelease)

  #[Just(_), Nothing] =>
    Just(ManifestFetchFailed)

  #[Just(_), Just(m)] =>
    pipe(
      .dependencies,
      resolveDeps,
      map(depSatisfied(registered)),
      List.filter(
        where {
          Just(_) =>
            true

          _ =>
            false
        },
      ),
      List.reduce((acc, reason) => !Maybe.isJust(acc) ? reason : acc, Nothing),
    )(m)
}
accumulatePackages = (acc, pendx) => where(pendx) {
  #[
    { name, owner, repository, description, version, tag, publishedAt, isBinding, deprecatedBy },
    Just(manifest),
  ] =>
    List.append(
      {
        name: manifest.name,
        owner,
        repository,
        description,
        latestVersion: manifest.version,
        latestTag: tag ?? "",
        latestUrl: `https://github.com/${owner}/${name}/archive/refs/tags/${tag ?? ""}.zip`,
        publishedAt,
        executable: manifest.bin != Nothing,
        isBinding,
        deprecatedBy,
        dependencies: resolveDeps(manifest.dependencies),
      },
      acc,
    )

  #[_, Nothing] =>
    acc
}
runWave :: Dictionary String Package
  -> List #[TableRow, Maybe Manifest]
  -> #[List Package, List #[TableRow, Maybe Manifest]]
runWave = (registered, pending) => {
  ready = List.filter(
    where {
      #[row, m] =>
        rowBlockReason(registered, #[row, m]) == Nothing
    },
    pending,
  )
  blocked = List.filter(
    where {
      #[row, m] =>
        rowBlockReason(registered, #[row, m]) != Nothing
    },
    pending,
  )
  packages = List.reduce(accumulatePackages, [], ready)
  return #[packages, blocked]
}
runFixedPoint :: Dictionary String Package
  -> List #[TableRow, Maybe Manifest]
  -> Integer
  -> List Package
  -> List Package
runFixedPoint = (registered, pending, waveNo, acc) => {
  #[packages, blocked] = runWave(registered, pending)

  return if (List.isEmpty(packages)) do {
    map(
      where {
        #[row, m] =>
          IO.pTrace("blocked", `${row.name} (${show(rowBlockReason(registered, #[row, m]))})`)
      },
    )(pending)
    return acc
  } else do {
    IO.pTrace(`wave ${show(waveNo)}`, map((pkg) => pkg.name, packages))
    newlyRegistered = List.reduce(
      (dict, pkg) => Dictionary.insert(pkg.name, pkg, dict),
      registered,
      packages,
    )
    return pipe(
      List.concat(acc),
      runFixedPoint(newlyRegistered, blocked, waveNo + 1),
    )(packages)
  }
}
// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------

// readify :: String -> Wish String (List #[TableRow, Maybe MadlibDotJson])
readify = pipe(
  File.read,
  map(parseTable),
  Wish.mapRej(Fn.always("can't read")),
  chain(fetchAllManifests),
)
main = (args) => {
  pipe(
    List.drop(1),
    map(
      pipe(
        readify,
        map(runFixedPoint({{}}, $, 1, [])),
        Wish.fulfill(
          (err) => {
            IO.pTrace("bootstrap failed", err)
            return {}
          },
          (pkgs) => {
            IO.pTrace("total packages", List.length(pkgs))
            return {}
          },
        ),
      ),
    ),
  )(args)
}
