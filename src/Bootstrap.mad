  Nothing =>
    Wish.bad("No tag")
}
*/

manifestUrl :: TableRow -> Wish String MadAtJson.MadlibDotJson
manifestUrl = (row) => pipe(
  .tag,
  where {
    Just(tag) =>
      pipe(
        Log.env.bootstrap("ARGS"),
        Shroud.execute("fetch"),
        map(Log.env.bootstrapDetail("processed?")),
        Wish.mapRej(.stderr),
        map(.stdout),
        // we need to break this up, as the above might write to /packages but isn't yet parseable
        // chain(MadAtJson.parse),
        Fn.always(Wish.bad("TEMPORARY INSANITY")),
      )([
        `--repo="https://github.com/${row.owner}/${row.name}"`,
        `--ref="v${row.version}"`,
        `--source-path="/madlib.json"`,
        `./packages/` ++ row.owner ++ "-" ++ row.name ++ "-" ++ row.version ++ "-madlib.json",
      ])

    Nothing =>
      Wish.bad("Unable to load")
  },
)(row)
// I didn't know this was a valid type construct, that's useful
adaptManifest :: MadAtJson.MadlibDotJson -> Manifest
adaptManifest = (x) => {
  { bin, dependencies, name, version } = x
  // return { bin, dependencies: Maybe.fromMaybe([], dependencies), main: x.main, name, version }
  return { bin, dependencies: Maybe.fromMaybe([], dependencies), main: x.main, name, version }
}
// parse failures fold to Nothing; MadAtJson.parse is plain Wish String, not
// Validate-wrapped, in v0.2.0 — nothing to distinguish (yet) between a soft
// warning and a hard error at this seam.
decodeManifest :: String -> Wish x (Maybe Manifest)
decodeManifest = pipe(
  MadAtJson.parse,
  map(
    pipe(
      adaptManifest,
      Just,
    ),
  ),
  Wish.chainRej((_) => Wish.good(Nothing)),
)
fetchManifest :: TableRow -> Wish String #[TableRow, Maybe Manifest]
fetchManifest = (row) => where(row.tag) {
  Nothing =>
    Wish.good(#[row, Nothing])

  Just(_) =>
    pipe(
      manifestUrl,
      map((x) => #[row, Just(adaptManifest(x))]),
    )(row)
}
fetchAllManifests :: List TableRow -> Wish String (List #[TableRow, Maybe Manifest])
fetchAllManifests = pipe(
  List.filter(.isPublished),
  map(fetchManifest),
  Wish.parallel,
)
alias ClassifiedPath = { branchPath :: String, localPath :: String, tagPath :: String }
classifyPinWithConfig :: ClassifiedPath -> String -> PinType
classifyPinWithConfig = ({ tagPath, branchPath, localPath }, url) => String.contains(tagPath, url)
  ? TagPin
  : String.contains(branchPath, url)
    ? BranchPin
    : String.startsWith(localPath, url) ? LocalPin : UnresolvedPin
classifyPin :: String -> PinType
classifyPin = classifyPinWithConfig({
  tagPath: "/archive/refs/tags/",
  branchPath: "/archive/refs/heads/",
  localPath: "file://",
})
repoNameFromUrl :: String -> Maybe String
repoNameFromUrl = pipe(
  String.split("/"),
  where {
    [_, _, _, _owner, repo, ..._] =>
      Just(repo)

    _ =>
      Nothing
  },
)
resolveDep :: MadAtJson.Dependency -> ResolvedDep
resolveDep = ({ url, versionRange }) => (
  {
    targetName: Maybe.fromMaybe("", repoNameFromUrl(url)),
    rawUrl: url,
    versionRange,
    pinType: repoNameFromUrl(url) == Nothing ? UnresolvedPin : classifyPin(url),
  }
)
resolveDeps :: List MadAtJson.Dependency -> List ResolvedDep
resolveDeps = map(resolveDep)
// ---------------------------------------------------------------------------
// The fixed point
// ---------------------------------------------------------------------------

depSatisfied :: Dictionary String Package -> ResolvedDep -> Maybe BlockReason
depSatisfied = (registered, { pinType, targetName, versionRange }) => where(pinType) {
  BranchPin =>
    Just(BranchPinnedDep(targetName))

  LocalPin =>
    Just(LocalDep(targetName))

  UnresolvedPin =>
    Just(DepNotRegistered(targetName))

  TagPin =>
    where(Dictionary.get(targetName, registered)) {
      Nothing =>
        Just(DepNotRegistered(targetName))

      Just(target) =>
        Version.withinRange(versionRange, target.latestVersion)
          ? Nothing
          : Just(DepNotRegistered(targetName))
    }
}
rowBlockReason :: Dictionary String Package -> #[TableRow, Maybe Manifest] -> Maybe BlockReason
rowBlockReason = (registered, #[row, manifest]) => where(#[row.tag, manifest]) {
  #[Nothing, _] =>
    Just(NoRelease)

  #[Just(_), Nothing] =>
    Just(ManifestFetchFailed)

  #[Just(_), Just(m)] =>
    pipe(
      .dependencies,
      resolveDeps,
      map(depSatisfied(registered)),
      List.filter(
        where {
          Just(_) =>
            true

          _ =>
            false
        },
      ),
      List.reduce((acc, reason) => !Maybe.isJust(acc) ? reason : acc, Nothing),
    )(m)
}
accumulatePackages = (acc, pendx) => where(pendx) {
  #[
    { name, owner, repository, description, version, tag, publishedAt, isBinding, deprecatedBy },
    Just(manifest),
  ] =>
    List.append(
      {
        name: manifest.name,
        owner,
        repository,
        description,
        latestVersion: manifest.version,
        latestTag: tag ?? "",
        latestUrl: `https://github.com/${owner}/${name}/archive/refs/tags/${tag ?? ""}.zip`,
        publishedAt,
        executable: manifest.bin != Nothing,
        isBinding,
        deprecatedBy,
        dependencies: resolveDeps(manifest.dependencies),
      },
      acc,
    )

  #[_, Nothing] =>
    acc
}
runWave :: Dictionary String Package
  -> List #[TableRow, Maybe Manifest]
  -> #[List Package, List #[TableRow, Maybe Manifest]]
runWave = (registered, pending) => {
  ready = List.filter(
    where {
      #[row, m] =>
        rowBlockReason(registered, #[row, m]) == Nothing
    },
    pending,
  )
  blocked = List.filter(
    where {
      #[row, m] =>
        rowBlockReason(registered, #[row, m]) != Nothing
    },
    pending,
  )
  packages = List.reduce(accumulatePackages, [], ready)
  return #[packages, blocked]
}
runFixedPoint :: Dictionary String Package
  -> List #[TableRow, Maybe Manifest]
  -> Integer
  -> List Package
  -> List Package
runFixedPoint = (registered, pending, waveNo, acc) => {
  #[packages, blocked] = runWave(registered, pending)

  return if (List.isEmpty(packages)) do {
    map(
      where {
        #[row, m] =>
          Log.env.bootstrap("blocked: " ++ row.name, rowBlockReason(registered, #[row, m]))
      },
    )(pending)
    return acc
  } else do {
    IO.pTrace(`wave ${show(waveNo)}`, map((pkg) => pkg.name, packages))
    newlyRegistered = List.reduce(
      (dict, pkg) => Dictionary.insert(pkg.name, pkg, dict),
      registered,
      packages,
    )
    return pipe(
      List.concat(acc),
      runFixedPoint(newlyRegistered, blocked, waveNo + 1),
    )(packages)
  }
}
// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------

// readify :: String -> Wish String (List #[TableRow, Maybe MadlibDotJson])
readify = pipe(
  File.read,
  map(parseTable),
  Wish.mapRej(Fn.always("can't read")),
  map(Log.env.bootstrapDetail("yeetail")),
  chain(fetchAllManifests),
)
main = (args) => {
  pipe(
    List.drop(1),
    map(
      pipe(
        readify,
        map(runFixedPoint({{}}, $, 1, [])),
        Wish.fulfill(
          (err) => {
            IO.pTrace("bootstrap failed", err)
            return {}
          },
          (pkgs) => {
            IO.pTrace("total packages", List.length(pkgs))
            return {}
          },
        ),
      ),
    ),
  )(args)
}
