  Nothing =>
    ""
}

manifestUrl :: TableRow -> Wish String MadAtJson.MadlibDotJson
manifestUrl = (row) => where(row.tag) {
  Just(tag) =>
    pipe(
      Shroud.walk("gh"),
      Wish.mapRej(.stderr),
      map(.stdout),
      chain(MadAtJson.parse),
    )([
      "api",
      "-H",
      `"Accept: application/vnd.github+json"`,
